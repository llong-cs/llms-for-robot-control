{
  "evaluation": {
    "bench": "ditto",
    "mode": "agent",
    "task_randomize": true
  },
  "environment": {
    "task_ids": "0",
    "difficulty": "medium",
    "trials": 1,
    "init_start": 0,
    "seed": 42
  },
  "execution": {
    "control_interface": "move_by",
    "h": 5,
    "k": 5,
    "max_steps": 450
  },
  "policy": {
    "inference_timeout": 1200.0
  },
  "observation": {
    "profile": "control"
  },
  "output": {
    "directory": "../outputs/{timestamp}-example-agent-local",
    "record_trajectory": true
  },
  "llm": {
    "model": "local/robot-vlm",
    "max_output_tokens": 8192,
    "max_attempts": 3,
    "augmentations": {
      "memory": {
        "history_length": 2
      }
    }
  }
}
